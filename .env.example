# ── Domaine (requis : règle Traefik Host) ─────────────────────────────
# Sous-domaine pointant vers le tunnel Cloudflare du serveur.
DOMAIN="tenues.voisilab.app"

# ── Base de données (Neon) ────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Authentification (session JWT) ────────────────────────────────────
# Générer : openssl rand -base64 32
AUTH_SECRET="replace_with_a_secure_random_string"

# ── Web Push (VAPID) ──────────────────────────────────────────────────
# Générer : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:contact@example.com"
